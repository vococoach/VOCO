{
  "name": "voco-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validate:passages": "node scripts/validate-passages.mjs",
    "validate:grammar": "node scripts/validate-grammar.mjs",
    "validate:vocab": "node --no-warnings --import ./scripts/register-loader.mjs scripts/validate-vocab.mjs",
    "test:first-visit": "node --no-warnings --import ./scripts/register-loader.mjs scripts/test-first-visit.mjs",
    "test:access": "node --no-warnings --import ./scripts/register-loader.mjs scripts/test-access.mjs",
    "test:practice": "node --no-warnings --import ./scripts/register-loader.mjs scripts/test-practice-test.mjs",
    "test:stripe": "node --no-warnings --import ./scripts/register-loader.mjs scripts/test-stripe-routes.mjs",
    "test:browser": "for f in verify1 verify2 verify3; do node --no-warnings --import ./scripts/register-loader.mjs scripts/browser/$f.mjs || exit 1; done",
    "test": "npm run validate:passages && npm run validate:grammar && npm run validate:vocab && npm run test:first-visit && npm run test:access && npm run test:practice && npm run test:stripe"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.383.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
